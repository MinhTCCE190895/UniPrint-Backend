@inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper Html
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    string NavClass(string page) => currentPage.Equals(page, StringComparison.OrdinalIgnoreCase) ? "nav-link text-white active fw-bold nav-active-underline" : "nav-link text-white";
    string NavClassWarning(string page) => currentPage.Equals(page, StringComparison.OrdinalIgnoreCase) ? "nav-link text-warning fw-bold active nav-active-underline" : "nav-link text-warning fw-semibold";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - UniPrint Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .nav-active-underline {
            position: relative;
        }
        .nav-active-underline::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 70%;
            height: 2px;
            background: #fff;
            border-radius: 2px;
        }
        .nav-active-underline.text-warning::after {
            background: #ffc107;
        }
        .nav-link { transition: opacity .15s; }
        .nav-link:not(.active):hover { opacity: .75; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold border-end border-light border-opacity-50 pe-3 me-3" asp-area="" asp-page="/Index">UniPrint</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("/Student/Documents")" asp-page="/Student/Documents">Tài Liệu Của Tôi</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Student/CreateOrder")" asp-page="/Student/CreateOrder">Đặt In</a>
                            </li>
                        }
                        @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("/Staff/Queue")" asp-page="/Staff/Queue">Hàng Đợi In (Staff)</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Staff/Shelves")" asp-page="/Staff/Shelves">Quản Lý Kệ</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Pickup/ScanQR")" asp-page="/Pickup/ScanQR">Quét Mã QR Nhận Hàng</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="@NavClassWarning("/StudyHub/Index")" asp-page="/StudyHub/Index">Study Hub</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-2">
                                <span class="nav-link text-white">
                                    Xin chào, <strong>@User.Identity.Name</strong>
                                    <span class="badge bg-light text-primary ms-1">
                                        @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Staff") ? "Staff" : "Sinh viên")
                                    </span>
                                </span>
                            </li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Auth/Logout" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Đăng Xuất</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm" asp-page="/Auth/Login">Đăng Nhập</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm fw-semibold" asp-page="/Auth/Register">Đăng Ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3 bg-light">
        <div class="container text-center">
            &copy; 2026 - UniPrint Platform (ASP.NET Core Razor Pages & Web API)
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
