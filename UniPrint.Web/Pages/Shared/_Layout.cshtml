    @inject Microsoft.AspNetCore.Mvc.Rendering.IHtmlHelper Html
    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
        string NavClass(string page) => currentPage.Equals(page, StringComparison.OrdinalIgnoreCase) 
            ? "app-nav-link active" 
            : "app-nav-link";
        string NavClassHighlight(string page) => currentPage.Equals(page, StringComparison.OrdinalIgnoreCase) 
            ? "app-nav-link active highlight" 
            : "app-nav-link highlight";
    }
    <!DOCTYPE html>
    <html lang="vi">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>@ViewData["Title"] - UniPrint Platform</title>

        <!-- Google Fonts: Plus Jakarta Sans, Inter, Lora (Vietnamese Diacritics Supported), JetBrains Mono -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700;800&family=Lora:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <style>
            .app-top-header {
                background-color: var(--bg-surface);
                border-bottom: 1px solid var(--border-card);
                position: sticky;
                top: 0;
                z-index: 1020;
            }
            .app-brand-badge {
                width: 34px;
                height: 34px;
                background-color: var(--accent);
                color: #ffffff;
                border-radius: var(--radius-md);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                position: relative;
            }
            .app-brand-text {
            font-size: 17px;
            font-weight: 800;
            color: var(--text-heading);
            letter-spacing: -0.4px;
        }
        .app-nav-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            border-radius: var(--radius-md);
            text-decoration: none;
            transition: all 0.15s ease;
            white-space: nowrap !important;
            flex-shrink: 0;
        }
        .app-nav-link:hover {
            color: var(--text-heading);
            background-color: var(--bg-subtle);
        }
        .app-nav-link.active {
            color: var(--accent);
            background-color: var(--accent-tint);
            font-weight: 700;
        }
        .app-nav-link.highlight {
            color: var(--stamp-amber);
        }
        .app-nav-link.highlight.active {
            background-color: var(--badge-pending-bg);
            color: var(--stamp-amber);
            font-weight: 700;
        }
        .app-user-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 4px 12px 4px 8px;
            border: 1px solid var(--border-card);
            border-radius: var(--radius-pill);
            background-color: var(--bg-surface);
            color: var(--text-heading);
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 600;
            white-space: nowrap !important;
            flex-shrink: 0;
        }
        .app-user-pill:hover {
            background-color: var(--bg-subtle);
            color: var(--text-heading);
        }
        .navbar-collapse,
        .navbar-nav {
            flex-wrap: wrap;
        }
    </style>
</head>
<body>
    <header class="app-top-header mb-4">
        <nav class="navbar navbar-expand-xl py-2">
            <div class="container flex-wrap">
                <!-- Brand Logo & Name with Print-Craft Registration Touch -->
                <a class="navbar-brand d-inline-flex align-items-center gap-2 me-4" asp-area="" asp-page="/Index">
                    <span class="app-brand-badge print-registered">
                        <svg class="craft-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 6 2 18 2 18 9"></polyline>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                            <rect x="6" y="14" width="12" height="8"></rect>
                        </svg>
                    </span>
                    <span class="app-brand-text">UniPrint</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#uniPrintNavbar" aria-controls="uniPrintNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between flex-wrap" id="uniPrintNavbar">
                    <!-- Main Navigation Links by Role (Preserved 100%) -->
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0 gap-1 flex-wrap">
                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("/Student/Documents")" asp-page="/Student/Documents">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                                    Tài Liệu Của Tôi
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Student/CreateOrder")" asp-page="/Student/CreateOrder">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                                    Đặt In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Student/Orders")" asp-page="/Student/Orders">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                                    Đơn Hàng Của Tôi
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("/Staff/Queue")" asp-page="/Staff/Queue">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    Hàng Đợi In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Staff/Shelves")" asp-page="/Staff/Shelves">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                                    Quản Lý Kệ
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Pickup/ScanQR")" asp-page="/Pickup/ScanQR">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                                    Quét QR Nhận Hàng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Pickup/Payments")" asp-page="/Pickup/Payments">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                                    Thanh Toán
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="@NavClass("/Admin/Users")" asp-page="/Admin/Users">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                    Người Dùng
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("/Admin/PriceConfig")" asp-page="/Admin/PriceConfig">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                                    Bảng Giá
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="@NavClassHighlight("/StudyHub/Index")" asp-page="/StudyHub/Index">
                                <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                                Study Hub
                            </a>
                        </li>
                    </ul>

                    <!-- User Actions & Authentication (Preserved 100%) -->
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="app-user-pill" asp-page="/Auth/Profile" title="Xem và cập nhật hồ sơ cá nhân">
                                <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                    <circle cx="12" cy="7" r="4"/>
                                </svg>
                                <span>@User.Identity.Name</span>
                                <span class="badge status-neutral">
                                    @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Staff") ? "Staff" : "Sinh viên")
                                </span>
                            </a>

                            <form method="post" asp-page="/Auth/Logout" class="d-inline m-0">
                                <button type="submit" class="btn btn-secondary btn-sm" title="Đăng xuất khỏi hệ thống">
                                    <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
                                    </svg>
                                    Đăng Xuất
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-secondary btn-sm" asp-page="/Auth/Login">Đăng Nhập</a>
                            <a class="btn btn-action btn-sm" asp-page="/Auth/Register">Đăng Ký</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container page-main-container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <!-- Campus Operational Station Footer (Nordic Atelier Standard) -->
    <footer class="app-footer mt-5 py-4">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom" style="border-color: var(--border-subtle) !important;">
                <!-- Column 1: Trạm In Trung Tâm -->
                <div class="col-lg-4 col-md-6 col-12">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="app-brand-badge print-registered" style="width: 28px; height: 28px;">
                            <svg class="craft-icon icon-sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 6 2 18 2 18 9"></polyline>
                                <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                <rect x="6" y="14" width="12" height="8"></rect>
                            </svg>
                        </span>
                        <strong style="font-size: 14.5px; color: var(--text-heading);">UniPrint Station</strong>
                    </div>
                    <p class="text-muted small mb-2" style="line-height: 1.5;">
                        Trạm dịch vụ in ấn học thuật & cung cấp học liệu trực tuyến phục vụ sinh viên và cán bộ giảng viên toàn trường.
                    </p>
                    <div class="text-muted small">
                        <div><strong>Thời gian phục vụ:</strong> Thứ Hai – Thứ Bảy (07:30 – 17:30)</div>
                        <div><strong>Hình thức nhận:</strong> Quét mã QR đối soát trực tiếp tại quầy trạm in</div>
                    </div>
                </div>

                <!-- Column 2: Quy chuẩn & Bảng giá in ấn -->
                <div class="col-lg-4 col-md-6 col-12">
                    <strong class="d-block mb-2" style="font-size: 13.5px; color: var(--text-heading);">Dịch Vụ & Biểu Phí Chuẩn</strong>
                    <ul class="list-unstyled text-muted small mb-0 d-flex flex-column gap-1">
                        <li>• In đen trắng: <strong>350đ / trang</strong> (A4) · In màu: <strong>1.500đ / trang</strong></li>
                        <li>• In hai mặt tự động: <strong>Giảm 10%</strong> chi phí giấy in</li>
                        <li>• Gia công sau in: Bấm kim góc (1.000đ) · Đóng gáy xoắn (5.000đ)</li>
                        <li>• Thanh toán linh hoạt: Tiền mặt hoặc quét mã VietQR / PayOS</li>
                    </ul>
                </div>

                <!-- Column 3: Trạng thái & Tiện ích trạm in -->
                <div class="col-lg-4 col-md-12 col-12">
                    <strong class="d-block mb-2" style="font-size: 13.5px; color: var(--text-heading);">Tiện Ích & Giám Sát</strong>
                    <div class="text-muted small d-flex flex-column gap-2">
                        <div>
                            <span class="badge status-available mono" style="font-size: 11px; white-space: normal !important; text-align: left; display: inline-flex;">
                                ● Trạm in trực tuyến: Sẵn sàng phục vụ
                            </span>
                        </div>
                        <div>• Tự động phân tích và đếm trang tệp PDF / DOCX</div>
                        <div>• Đối soát nhận tài liệu bằng mã QR đối soát bảo mật</div>
                    </div>
                </div>
            </div>

            <!-- Footer Bottom Sub-bar -->
            <div class="d-flex justify-content-between align-items-center pt-3 flex-wrap gap-2 text-muted" style="font-size: 12px;">
                <div>
                    &copy; 2026 <strong>UniPrint Platform</strong> · Trạm Dịch Vụ In Ấn Trường Đại Học
                </div>
                <div class="d-flex gap-3">
                    <a asp-page="/Privacy" class="text-muted">Chính sách bảo mật tài liệu</a>
                    <span>·</span>
                    <a asp-page="/StudyHub/Index" class="text-muted">Kho học liệu Study Hub</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
