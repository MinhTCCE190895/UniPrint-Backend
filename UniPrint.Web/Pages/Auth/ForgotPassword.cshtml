@page
@model UniPrint.Web.Pages.Auth.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên Mật Khẩu - UniPrint Platform";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card p-4">
            <div class="text-center mb-4 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                <div class="app-brand-badge mx-auto mb-2" style="width: 40px; height: 40px;">
                    <svg class="icon-duotone" viewBox="0 0 24 24">
                        <rect class="bg-shape" x="5" y="11" width="14" height="10" rx="2" style="fill:#fff; opacity:0.25;" />
                        <path class="stroke-shape" d="M7 11V7a5 5 0 0110 0v4M5 11h14v10H5zM12 15v2" style="stroke:#fff;" />
                    </svg>
                </div>
                <h4 class="mb-1" style="font-weight: 700; color: var(--text-heading);">KHÔI PHỤC MẬT KHẨU</h4>
                <p class="mb-0 small text-muted" style="font-weight: 500;">
                    @(!Model.IsOtpSent
                        ? "Bước 1/2: Nhập email tài khoản để nhận mã xác thực OTP"
                        : "Bước 2/2: Nhập mã OTP 6 số và thiết lập mật khẩu mới")
                </p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center justify-content-between mb-3" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <svg class="icon-duotone icon-sm flex-shrink-0" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M12 8v4M12 16h.01"/></svg>
                        <span>@Model.ErrorMessage</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.InfoMessage))
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center justify-content-between mb-3" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <svg class="icon-duotone icon-sm flex-shrink-0" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span>@Model.InfoMessage</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (!Model.IsOtpSent)
            {
                <form method="post" asp-page-handler="SendOtp">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email đã đăng ký</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="student@uniprint.edu.vn" required autofocus />
                        <div class="form-text">Mã OTP 6 chữ số có hiệu lực trong vòng 10 phút (tối đa 5 lần nhập sai).</div>
                    </div>
                    <button type="submit" class="btn btn-action w-100 py-2 d-inline-flex align-items-center justify-content-center gap-2">
                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="stroke-shape" d="M3 8l9 6 9-6M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"/></svg>
                        <span>Gửi Mã OTP Xác Thực</span>
                    </button>
                </form>
            }
            else
            {
                <div class="p-3 rounded mb-3 d-flex justify-content-between align-items-center" style="background: var(--surface-subtle); border: 1px solid var(--border-subtle);">
                    <div class="small">
                        <div class="text-muted">Tài khoản khôi phục</div>
                        <div class="fw-semibold" style="color: var(--text-heading);">@Model.Email</div>
                    </div>
                    <a asp-page="/Auth/ForgotPassword" class="btn btn-sm btn-secondary">Đổi email</a>
                </div>

                @if (!string.IsNullOrEmpty(Model.DemoOtpCode))
                {
                    <div class="p-3 rounded mb-3" style="background: #FFFBEB; border: 1px solid #FDE68A; color: var(--intent-alert-base);">
                        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                            <div>
                                <div class="small fw-bold text-uppercase" style="letter-spacing: 0.03em;">Dev Sandbox OTP</div>
                                <div class="small">
                                    Mã xác thực của bạn:
                                    <span class="mono fw-bold fs-5 ms-1" id="demoOtpValue">@Model.DemoOtpCode</span>
                                </div>
                                @if (Model.ExpiresAtUtc.HasValue)
                                {
                                    <div class="small opacity-75">Hết hạn lúc @Model.ExpiresAtUtc.Value.ToLocalTime().ToString("HH:mm:ss dd/MM/yyyy")</div>
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-secondary" onclick="fillDemoOtp()">
                                Điền nhanh OTP
                            </button>
                        </div>
                    </div>
                }

                <form method="post" asp-page-handler="ResetPassword">
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="IsOtpSent" value="true" />
                    <input type="hidden" asp-for="DemoOtpCode" />
                    <input type="hidden" asp-for="ExpiresAtUtc" />

                    <div class="mb-3">
                        <label asp-for="OtpCode" class="form-label">Mã OTP (6 chữ số)</label>
                        <input asp-for="OtpCode"
                               id="inputOtpCode"
                               class="form-control mono text-center fw-bold fs-5"
                               style="letter-spacing: 0.35em;"
                               maxlength="6"
                               inputmode="numeric"
                               pattern="[0-9]{6}"
                               placeholder="••••••"
                               autocomplete="one-time-code"
                               required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">Mật khẩu mới</label>
                        <div class="input-group">
                            <input asp-for="NewPassword" id="inputNewPassword" type="password" class="form-control" minlength="6" placeholder="Ít nhất 6 ký tự" required />
                            <button type="button" class="btn btn-secondary" onclick="togglePwd('inputNewPassword', this)" aria-label="Hiện/ẩn mật khẩu">Hiện</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                        <div class="input-group">
                            <input asp-for="ConfirmPassword" id="inputConfirmPassword" type="password" class="form-control" minlength="6" placeholder="Nhập lại mật khẩu mới" required />
                            <button type="button" class="btn btn-secondary" onclick="togglePwd('inputConfirmPassword', this)" aria-label="Hiện/ẩn mật khẩu">Hiện</button>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-confirm py-2 fw-semibold">Xác Nhận Đặt Lại Mật Khẩu</button>
                        <button type="submit"
                                formaction="?handler=SendOtp"
                                formnovalidate
                                class="btn btn-secondary btn-sm">
                            Gửi lại mã OTP mới
                        </button>
                    </div>
                </form>
            }

            <hr class="my-4" style="border-color: var(--border-subtle);" />

            <div class="text-center small">
                <a asp-page="/Auth/Login" class="fw-semibold text-decoration-none" style="color: var(--intent-action-base);">
                    ← Quay lại trang Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillDemoOtp() {
            const otpVal = document.getElementById('demoOtpValue')?.textContent?.trim();
            const otpInput = document.getElementById('inputOtpCode');
            if (otpVal && otpInput) {
                otpInput.value = otpVal;
                document.getElementById('inputNewPassword')?.focus();
            }
        }

        function togglePwd(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.textContent = show ? 'Ẩn' : 'Hiện';
        }
    </script>
}

