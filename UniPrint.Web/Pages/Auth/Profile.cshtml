@page
@model UniPrint.Web.Pages.Auth.ProfileModel
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân - UniPrint Platform";

    // [UI Presentation Only] Ký tự chữ cái đầu tiên phục vụ hiển thị Avatar chữ và cờ xác định tab kích hoạt trên giao diện
    var userInitial = !string.IsNullOrWhiteSpace(Model.UserProfile?.FullName)
        ? Model.UserProfile.FullName.Trim().Substring(0, 1).ToUpper()
        : "U";
    var isInfoTab = Model.ActiveTab == "info";
}

<div class="container py-3">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0" style="font-size: 13px;">
            <li class="breadcrumb-item"><a asp-page="/Index" style="color: var(--intent-action-base);">Trang chủ</a></li>
            <li class="breadcrumb-item active text-muted" aria-current="page">Hồ sơ cá nhân</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Cột trái: Tóm tắt thông tin tài khoản -->
        <div class="col-lg-4">
            <div class="card p-4 text-center mb-3">
                <!-- Avatar tròn với màu Nordic Teal -->
                <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center text-white fw-bold mono"
                     style="width: 88px; height: 88px; font-size: 2rem; background-color: var(--intent-action-base); border: 2px solid var(--border-strong);">
                    @userInitial
                </div>

                <h4 class="mb-1" style="font-weight: 700; color: var(--text-heading);">
                    @(Model.UserProfile?.FullName ?? "Người dùng")
                </h4>
                <p class="text-muted small mb-3">@(Model.UserProfile?.Email ?? "")</p>

                <div class="mb-3">
                    @if (Model.UserProfile?.Role == UniPrint.DataAccess.Enums.UserRole.Admin)
                    {
                        <span class="badge status-depleted px-3 py-2">
                            <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="stroke-shape" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            Quản Trị Viên
                        </span>
                    }
                    else if (Model.UserProfile?.Role == UniPrint.DataAccess.Enums.UserRole.Staff)
                    {
                        <span class="badge status-available px-3 py-2">
                            <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="bg-shape" d="M4 6h16v12H4z"/><path class="stroke-shape" d="M3 6h18M3 12h18M3 18h18M4 6v12M20 6v12"/></svg>
                            Nhân Viên In Ấn
                        </span>
                    }
                    else
                    {
                        <span class="badge status-neutral px-3 py-2">
                            <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="7" r="4"/><path class="stroke-shape" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle class="stroke-shape" cx="12" cy="7" r="4"/></svg>
                            Sinh Viên
                        </span>
                    }
                </div>

                <hr class="my-3" style="border-color: var(--border-subtle);" />

                <div class="text-start small">
                    <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                        <span class="text-muted">Mã tài khoản:</span>
                        <span class="mono text-muted" title="@Model.UserProfile?.Id">
                            @(Model.UserProfile?.Id.ToString().Substring(0, 8))...
                        </span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                        <span class="text-muted">Trạng thái:</span>
                        <span class="badge status-available">Đang hoạt động</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted">Số điện thoại:</span>
                        <span class="mono" style="font-weight: 600; color: var(--text-heading);">
                            @(string.IsNullOrEmpty(Model.UserProfile?.PhoneNumber) ? "Chưa liên kết" : Model.UserProfile.PhoneNumber)
                        </span>
                    </div>
                </div>
            </div>

            <!-- Gợi ý bảo mật -->
            <div class="tonal-panel p-3" style="font-size: 12.5px;">
                <div class="d-flex align-items-center gap-2 mb-2" style="font-weight: 700; color: var(--intent-action-base);">
                    <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="stroke-shape" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    LƯU Ý BẢO MẬT
                </div>
                <ul class="list-unstyled text-muted mb-0 d-flex flex-column gap-2 ps-1">
                    <li>✓ Không chia sẻ tài khoản hoặc mật khẩu cho người khác.</li>
                    <li>✓ Nên đổi mật khẩu định kỳ 3 - 6 tháng một lần.</li>
                    <li>✓ Số điện thoại được dùng để nhân viên liên hệ khi đơn in có sự cố.</li>
                </ul>
            </div>
        </div>

        <!-- Cột phải: Form Cập nhật thông tin & Đổi mật khẩu (Preserved 100%) -->
        <div class="col-lg-8">
            <div class="card p-0 overflow-hidden">
                <div class="card-header p-3 border-bottom d-flex gap-2" style="background-color: var(--surface-subtle); border-color: var(--border-card) !important;">
                    <ul class="nav nav-pills gap-2" id="profileTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="btn @(isInfoTab ? "btn-action" : "btn-secondary") btn-sm"
                                    id="info-tab" data-bs-toggle="pill" data-bs-target="#info-pane"
                                    type="button" role="tab" aria-controls="info-pane" aria-selected="@(isInfoTab ? "true" : "false")">
                                <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="7" r="4"/><path class="stroke-shape" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle class="stroke-shape" cx="12" cy="7" r="4"/></svg>
                                Cập Nhật Thông Tin
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="btn @(!isInfoTab ? "btn-action" : "btn-secondary") btn-sm"
                                    id="password-tab" data-bs-toggle="pill" data-bs-target="#password-pane"
                                    type="button" role="tab" aria-controls="password-pane" aria-selected="@(!isInfoTab ? "true" : "false")">
                                <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><rect class="bg-shape" x="3" y="11" width="18" height="11" rx="2" ry="2"/><path class="stroke-shape" d="M7 11V7a5 5 0 0110 0v4"/></svg>
                                Đổi Mật Khẩu
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4">
                    <div class="tab-content" id="profileTabsContent">
                        <!-- TAB 1: THÔNG TIN CÁ NHÂN (Preserved 100%) -->
                        <div class="tab-pane fade @(isInfoTab ? "show active" : "")" id="info-pane" role="tabpanel" aria-labelledby="info-tab">
                            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center justify-content-between mb-4" role="alert">
                                    <div class="d-flex align-items-center gap-2">
                                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M8 12l3 3 5-5"/></svg>
                                        <span>@Model.SuccessMessage</span>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center justify-content-between mb-4" role="alert">
                                    <div class="d-flex align-items-center gap-2">
                                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M12 8v4M12 16h.01"/></svg>
                                        <span>@Model.ErrorMessage</span>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            <form method="post" asp-page-handler="UpdateProfile">
                                <div class="mb-3">
                                    <label class="form-label">Email trường cấp</label>
                                    <input type="text" class="form-control" style="background-color: var(--surface-subtle);" value="@(Model.UserProfile?.Email)" readonly disabled />
                                    <div class="form-text text-muted" style="font-size: 12px;">Email là định danh tài khoản và không thể chỉnh sửa.</div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên đầy đủ" required />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="PhoneNumber" class="form-label">Số điện thoại liên hệ</label>
                                    <input asp-for="PhoneNumber" class="form-control mono" placeholder="Ví dụ: 0912345678" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                    <div class="form-text text-muted" style="font-size: 12px;">Cung cấp số điện thoại chính xác để nhận thông báo nhận tài liệu khi cần.</div>
                                </div>

                                <div class="d-flex justify-content-end">
                                    <button type="submit" class="btn btn-action px-4 py-2">
                                        Lưu Thay Đổi
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- TAB 2: ĐỔI MẬT KHẨU (Preserved 100%) -->
                        <div class="tab-pane fade @(!isInfoTab ? "show active" : "")" id="password-pane" role="tabpanel" aria-labelledby="password-tab">
                            @if (!string.IsNullOrEmpty(Model.PasswordSuccessMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center justify-content-between mb-4" role="alert">
                                    <div class="d-flex align-items-center gap-2">
                                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M8 12l3 3 5-5"/></svg>
                                        <span>@Model.PasswordSuccessMessage</span>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.PasswordErrorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center justify-content-between mb-4" role="alert">
                                    <div class="d-flex align-items-center gap-2">
                                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M12 8v4M12 16h.01"/></svg>
                                        <span>@Model.PasswordErrorMessage</span>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            <form method="post" asp-page-handler="ChangePassword">
                                <div class="mb-3">
                                    <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                                    <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" required />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="NewPassword" class="form-label">Mật khẩu mới <span class="text-danger">*</span></label>
                                    <input asp-for="NewPassword" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                                    <div class="form-text text-muted" style="font-size: 12px;">Mật khẩu mới phải khác mật khẩu hiện tại và có tối thiểu 6 ký tự.</div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" required />
                                </div>

                                <div class="d-flex justify-content-end">
                                    <button type="submit" class="btn btn-action px-4 py-2">
                                        Cập Nhật Mật Khẩu
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
