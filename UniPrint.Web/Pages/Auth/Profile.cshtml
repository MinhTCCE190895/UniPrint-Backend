@page
@model UniPrint.Web.Pages.Auth.ProfileModel
@{
    ViewData["Title"] = "Hồ Sơ Cá Nhân - UniPrint";
    var userInitial = !string.IsNullOrWhiteSpace(Model.UserProfile?.FullName)
        ? Model.UserProfile.FullName.Trim().Substring(0, 1).ToUpper()
        : "U";
    var isInfoTab = Model.ActiveTab == "info";
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Hồ sơ cá nhân</li>
        </ol>
    </nav>

    <div class="row g-4">
        <!-- Cột trái: Tóm tắt thông tin tài khoản -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body text-center p-4">
                    <!-- Avatar tròn với màu gradient -->
                    <div class="mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow"
                         style="width: 96px; height: 96px; font-size: 2.2rem; background: linear-gradient(135deg, #0d6efd 0%, #0099ff 100%);">
                        @userInitial
                    </div>

                    <h4 class="fw-bold mb-1">@(Model.UserProfile?.FullName ?? "Người dùng")</h4>
                    <p class="text-muted small mb-3">@(Model.UserProfile?.Email ?? "")</p>

                    <div class="mb-3">
                        @if (Model.UserProfile?.Role == UniPrint.DataAccess.Enums.UserRole.Admin)
                        {
                            <span class="badge bg-danger px-3 py-2 fs-6">🛡️ Quản Trị Viên</span>
                        }
                        else if (Model.UserProfile?.Role == UniPrint.DataAccess.Enums.UserRole.Staff)
                        {
                            <span class="badge bg-success px-3 py-2 fs-6">👔 Nhân Viên In Ấn</span>
                        }
                        else
                        {
                            <span class="badge bg-primary px-3 py-2 fs-6">🎓 Sinh Viên</span>
                        }
                    </div>

                    <hr class="my-3" />

                    <div class="text-start small">
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Mã tài khoản:</span>
                            <span class="fw-monospace text-secondary" title="@Model.UserProfile?.Id">
                                @(Model.UserProfile?.Id.ToString().Substring(0, 8))...
                            </span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Trạng thái:</span>
                            <span class="text-success fw-semibold">● Đang hoạt động</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted">Số điện thoại:</span>
                            <span class="fw-semibold">@(string.IsNullOrEmpty(Model.UserProfile?.PhoneNumber) ? "Chưa liên kết" : Model.UserProfile.PhoneNumber)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gợi ý bảo mật -->
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body p-3">
                    <h6 class="fw-bold text-dark mb-2">💡 Lưu ý bảo mật</h6>
                    <ul class="list-unstyled small text-muted mb-0 ps-1">
                        <li class="mb-2">✓ Không chia sẻ tài khoản hoặc mật khẩu cho người khác.</li>
                        <li class="mb-2">✓ Nên đổi mật khẩu định kỳ 3 - 6 tháng một lần.</li>
                        <li>✓ Số điện thoại được dùng để nhân viên liên hệ khi đơn in có sự cố.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Cột phải: Form Cập nhật thông tin & Đổi mật khẩu -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom p-3">
                    <ul class="nav nav-pills card-header-pills" id="profileTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(isInfoTab ? "active" : "") fw-semibold"
                                    id="info-tab" data-bs-toggle="pill" data-bs-target="#info-pane"
                                    type="button" role="tab" aria-controls="info-pane" aria-selected="@(isInfoTab ? "true" : "false")">
                                👤 Cập Nhật Thông Tin
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(!isInfoTab ? "active" : "") fw-semibold"
                                    id="password-tab" data-bs-toggle="pill" data-bs-target="#password-pane"
                                    type="button" role="tab" aria-controls="password-pane" aria-selected="@(!isInfoTab ? "true" : "false")">
                                🔑 Đổi Mật Khẩu
                            </button>
                        </li>
                    </ul>
                </div>

                <div class="card-body p-4">
                    <div class="tab-content" id="profileTabsContent">
                        <!-- TAB 1: THÔNG TIN CÁ NHÂN -->
                        <div class="tab-pane fade @(isInfoTab ? "show active" : "")" id="info-pane" role="tabpanel" aria-labelledby="info-tab">
                            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                                    <span class="me-2 fs-5">✓</span>
                                    <div>@Model.SuccessMessage</div>
                                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                                    <span class="me-2 fs-5">⚠️</span>
                                    <div>@Model.ErrorMessage</div>
                                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            <form method="post" asp-page-handler="UpdateProfile">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Email trường cấp</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted">✉️</span>
                                        <input type="text" class="form-control bg-light" value="@(Model.UserProfile?.Email)" readonly disabled />
                                    </div>
                                    <div class="form-text text-muted">Email là định danh tài khoản và không thể chỉnh sửa.</div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="FullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">👤</span>
                                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên đầy đủ" required />
                                    </div>
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại liên hệ</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">📱</span>
                                        <input asp-for="PhoneNumber" class="form-control" placeholder="Ví dụ: 0912345678 hoặc +84912345678" />
                                    </div>
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                    <div class="form-text text-muted">Cung cấp số điện thoại chính xác để nhận thông báo nhận tài liệu khi cần.</div>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold shadow-sm">
                                        💾 Lưu Thay Đổi
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- TAB 2: ĐỔI MẬT KHẨU -->
                        <div class="tab-pane fade @(!isInfoTab ? "show active" : "")" id="password-pane" role="tabpanel" aria-labelledby="password-tab">
                            @if (!string.IsNullOrEmpty(Model.PasswordSuccessMessage))
                            {
                                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                                    <span class="me-2 fs-5">✓</span>
                                    <div>@Model.PasswordSuccessMessage</div>
                                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(Model.PasswordErrorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                                    <span class="me-2 fs-5">⚠️</span>
                                    <div>@Model.PasswordErrorMessage</div>
                                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            <form method="post" asp-page-handler="ChangePassword">
                                <div class="mb-3">
                                    <label asp-for="CurrentPassword" class="form-label fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">🔒</span>
                                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="••••••••" required />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">🔑</span>
                                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                                    </div>
                                    <div class="form-text text-muted">Mật khẩu mới phải khác mật khẩu hiện tại và có tối thiểu 6 ký tự.</div>
                                </div>

                                <div class="mb-4">
                                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">🔑</span>
                                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" required />
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end gap-2">
                                    <button type="submit" class="btn btn-warning px-4 py-2 fw-semibold shadow-sm text-dark">
                                        🔒 Cập Nhật Mật Khẩu
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
