@page
@model UniPrint.Web.Pages.Auth.RegisterModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản - UniPrint Platform";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-6 col-lg-5">
        <div class="card craft-card print-registered p-4">
            <div class="text-center mb-4 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                <div class="app-brand-badge mx-auto mb-2 print-registered" style="width: 40px; height: 40px;">
                    <svg class="craft-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 6 2 18 2 18 9"></polyline>
                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                        <rect x="6" y="14" width="12" height="8"></rect>
                    </svg>
                </div>
                <h4 class="mb-1 font-editorial" style="font-weight: 400; font-size: 24px; color: var(--text-heading);">ĐĂNG KÝ TÀI KHOẢN</h4>
                <p class="mb-0 small text-muted" style="font-weight: 500;">Dành cho sinh viên sử dụng hệ thống in ấn UniPrint</p>
            </div>

            <!-- Error Alert (Preserved 100%) -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center justify-content-between mb-4" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M12 8v4M12 16h.01"/></svg>
                        <span>@Model.ErrorMessage</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email trường cấp <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" placeholder="sinhvien@uniprint.edu.vn" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="0912345678" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 6 ký tự" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-action w-100 py-2">Đăng Ký Ngay</button>
            </form>

            <div class="mt-4 text-center" style="font-size: 13px;">
                <span class="text-muted">Đã có tài khoản?</span>
                <a asp-page="/Auth/Login" class="fw-semibold ms-1" style="color: var(--intent-action-base);">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
