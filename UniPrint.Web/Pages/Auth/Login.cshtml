@page
@model UniPrint.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Đăng Nhập - UniPrint Platform";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5 col-lg-4">
        <div class="card p-4">
            <div class="text-center mb-4 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                <div class="app-brand-badge mx-auto mb-2" style="width: 40px; height: 40px;">
                    <svg class="icon-duotone" viewBox="0 0 24 24">
                        <path class="bg-shape" d="M6 9h12v9H6z" style="fill:#fff; opacity:0.25;"/>
                        <path class="stroke-shape" d="M6 9V3h12v6M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v7H6z" style="stroke:#fff;"/>
                    </svg>
                </div>
                <h4 class="mb-1" style="font-weight: 700; color: var(--text-heading);">ĐĂNG NHẬP UNIPRINT</h4>
                <p class="mb-0 small text-muted" style="font-weight: 500;">Hệ thống in ấn & lưu trữ học thuật</p>
            </div>

            <!-- Error Alert (Preserved 100%) -->
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center justify-content-between mb-4" role="alert">
                    <div class="d-flex align-items-center gap-2">
                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M12 8v4M12 16h.01"/></svg>
                        <span>@Model.ErrorMessage</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email trường cấp</label>
                    <input asp-for="Email" class="form-control" id="inputEmail" placeholder="student@uniprint.edu.vn" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" type="password" class="form-control" id="inputPassword" placeholder="••••••••" required />
                </div>
                <button type="submit" class="btn btn-action w-100 py-2">Đăng Nhập</button>
            </form>

            <div class="mt-3 text-center" style="font-size: 13px;">
                <span class="text-muted">Chưa có tài khoản?</span>
                <a asp-page="/Auth/Register" class="fw-semibold ms-1" style="color: var(--intent-action-base);">Đăng ký ngay</a>
            </div>

            <hr class="my-4" style="border-color: var(--border-subtle);" />

            <div class="text-muted small">
                <div class="fw-bold mb-2 text-center text-secondary">Tài khoản thử nghiệm nhanh (Mật khẩu: <span class="mono">123456</span>):</div>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('student@uniprint.edu.vn', '123456')">
                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="7" r="4"/><path class="stroke-shape" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/></svg>
                        Sinh viên
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('staff@uniprint.edu.vn', '123456')">
                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="bg-shape" d="M4 6h16v12H4z"/><path class="stroke-shape" d="M3 6h18M3 12h18M3 18h18M4 6v12M20 6v12"/></svg>
                        Nhân viên
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" onclick="quickFill('admin@uniprint.edu.vn', '123456')">
                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="stroke-shape" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Quản trị viên
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function quickFill(email, password) {
            document.getElementById('inputEmail').value = email;
            document.getElementById('inputPassword').value = password;
        }
    </script>
}
