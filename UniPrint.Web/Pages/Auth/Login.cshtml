@page
@model UniPrint.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Đăng Nhập - UniPrint";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0 fw-bold">ĐĂNG NHẬP UNIPRINT</h4>
                <p class="mb-0 small text-white-50">Hệ thống in ấn sinh viên thông minh</p>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email trường cấp</label>
                        <input asp-for="Email" class="form-control" id="inputEmail" placeholder="student@uniprint.edu.vn" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                        <input asp-for="Password" type="password" class="form-control" id="inputPassword" placeholder="••••••••" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Đăng Nhập</button>
                </form>

                <div class="mt-3 text-center">
                    <span class="text-muted">Chưa có tài khoản?</span>
                    <a asp-page="/Auth/Register" class="text-primary fw-semibold ms-1">Đăng ký ngay</a>
                </div>

                <hr class="my-4" />

                <div class="text-muted small">
                    <div class="fw-bold mb-2 text-center text-secondary">Tài khoản thử nghiệm nhanh (Mật khẩu: <code>123456</code>):</div>
                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="quickFill('student@uniprint.edu.vn', '123456')">
                            🎓 Sinh viên
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="quickFill('staff@uniprint.edu.vn', '123456')">
                            👔 Nhân viên
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="quickFill('admin@uniprint.edu.vn', '123456')">
                            🛡️ Quản trị viên
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function quickFill(email, password) {
            document.getElementById('inputEmail').value = email;
            document.getElementById('inputPassword').value = password;
        }
    </script>
}
