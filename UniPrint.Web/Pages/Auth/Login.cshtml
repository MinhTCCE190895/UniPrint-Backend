@page
@model UniPrint.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Đăng Nhập - UniPrint";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white text-center py-3">
                <h4 class="mb-0">ĐĂNG NHẬP UNIPRINT</h4>
            </div>
            <div class="card-body p-4">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Email trường cấp</label>
                        <input asp-for="Email" class="form-control" placeholder="student@uniprint.edu.vn" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Mật khẩu</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">Đăng Nhập</button>
                </form>
                <div class="mt-3 text-muted small text-center">
                    Tài khoản demo: <code>admin@uniprint.edu.vn</code> | <code>staff@uniprint.edu.vn</code> | <code>student@uniprint.edu.vn</code> (Pass: <code>123456</code>)
                </div>
            </div>
        </div>
    </div>
</div>
