@page
@model UniPrint.Web.Pages.Student.CreateOrderModel
@{
    ViewData["Title"] = "Đặt In Tài Liệu";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2><i class="bi bi-printer text-primary"></i> ĐẶT IN TÀI LIỆU TRỰC TUYẾN</h2>
            <p class="text-muted mb-0">Cấu hình in và chốt giá in theo quy tắc nghiệp vụ BR02.</p>
        </div>
        <a asp-page="/Student/Documents" class="btn btn-outline-secondary">
            <i class="bi bi-folder2-open"></i> Quản Lý Tài Liệu
        </a>
    </div>
    <hr />

    <div class="row">
        <div class="col-md-7">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-light"><strong>Bước 1: Chọn tài liệu & Cấu hình in</strong></div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tài liệu cần in</label>
                            @if (!string.IsNullOrEmpty(Model.SelectedDocumentName))
                            {
                                <div class="alert alert-primary py-2 d-flex justify-content-between align-items-center mb-0">
                                    <span><i class="bi bi-file-earmark-text me-1"></i> <strong>@Model.SelectedDocumentName</strong></span>
                                    <span class="badge bg-primary">@Model.PageCount trang</span>
                                </div>
                                <input type="hidden" asp-for="DocumentId" />
                            }
                            else if (Model.MyDocuments.Any())
                            {
                                <select asp-for="DocumentId" class="form-select" onchange="window.location.href = '/Student/CreateOrder?documentId=' + this.value;">
                                    <option value="">-- Chọn tài liệu từ kho cá nhân --</option>
                                    @foreach (var doc in Model.MyDocuments)
                                    {
                                        <option value="@doc.Id">@doc.FileName (@doc.PageCount trang)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 mb-0">
                                    Bạn chưa có tài liệu nào. <a asp-page="/Student/Documents" class="fw-bold">Tải lên tài liệu tại đây</a> để tự động tính trang!
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Số trang in (Tự động đọc từ file)</label>
                            <input asp-for="PageCount" class="form-control" type="number" min="1" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Số bản in (Copies)</label>
                            <input asp-for="NumberOfCopies" class="form-control" type="number" min="1" value="1" />
                        </div>
                        <div class="form-check mb-2">
                            <input asp-for="IsColor" class="form-check-input" type="checkbox" id="isColor" />
                            <label class="form-check-label" for="isColor">In màu (Mặc định: Trắng đen)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input asp-for="IsDoubleSided" class="form-check-input" type="checkbox" id="isDoubleSided" checked />
                            <label class="form-check-label" for="isDoubleSided">In 2 mặt (Tiết kiệm 10% chi phí)</label>
                        </div>
                        <div class="form-check mb-2">
                            <input asp-for="HasBinding" class="form-check-input" type="checkbox" id="hasBinding" />
                            <label class="form-check-label" for="hasBinding">Đóng gáy sách (+5.000 VNĐ/bản)</label>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="HasStaple" class="form-check-input" type="checkbox" id="hasStaple" checked />
                            <label class="form-check-label" for="hasStaple">Bấm kim góc (+1.000 VNĐ/bản)</label>
                        </div>
                        <button type="submit" class="btn btn-success w-100 py-2">Xác Nhận Đặt In</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white"><strong>Tạm tính chi phí</strong></div>
                <div class="card-body">
                    <p class="text-muted">Giá được chốt cố định tại thời điểm tạo đơn theo quy tắc BR02.</p>
                    <div class="alert alert-info">
                        <strong>Bảng giá tham khảo:</strong><br />
                        - Trang đen trắng: 350đ / trang<br />
                        - Trang in màu: 1.500đ / trang<br />
                        - Giảm giá 2 mặt: -10%<br />
                        - Bấm ghim: 1.000đ | Đóng gáy: 5.000đ
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
