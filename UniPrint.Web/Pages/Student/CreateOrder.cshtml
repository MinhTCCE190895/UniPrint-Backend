@page
@model UniPrint.Web.Pages.Student.CreateOrderModel
@using UniPrint.DataAccess.Enums
@{
    ViewData["Title"] = "Đặt In Tài Liệu Trực Tuyến";
}

<div class="container mt-2">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="mb-1 d-flex align-items-center gap-2 font-editorial" style="font-size: 26px; font-weight: 400;">
                <svg class="craft-icon icon-lg" style="color: var(--accent);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 6 2 18 2 18 9"></polyline>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                    <rect x="6" y="14" width="12" height="8"></rect>
                </svg>
                ĐẶT IN TÀI LIỆU TRỰC TUYẾN
            </h2>
            <div class="text-muted" style="font-size: 13.5px; font-weight: 500;">
                Tùy chỉnh thông số in ấn, xem chi phí minh bạch và chốt giá cố định trước khi gửi lệnh in
            </div>
        </div>
        <a asp-page="/Student/Documents" class="btn btn-secondary">
            <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="bg-shape" d="M6 3h8l6 6v12H6z"/><path class="stroke-shape" d="M14 3v6h6M6 3h8l6 6v12a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2zM9 13h6M9 17h4"/></svg>
            Kho Tài Liệu Cá Nhân
        </a>
    </div>

    <!-- Alert Message (Preserved 100%) -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center justify-content-between mb-4" role="alert">
            <div class="d-flex align-items-center gap-2">
                <svg class="icon-duotone" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M12 8v4M12 16h.01"/></svg>
                <span>@Model.ErrorMessage</span>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Order Created Success Screen (Preserved 100% data & actions) -->
    @if (Model.CreatedOrder != null)
    {
        <div class="card mb-4" style="border-color: var(--intent-confirm-border);">
            <div class="card-header d-flex align-items-center justify-content-between py-3" style="background-color: var(--intent-confirm-tint);">
                <div class="d-flex align-items-center gap-2" style="color: var(--intent-confirm-base);">
                    <svg class="icon-duotone" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M8 12l3 3 5-5"/></svg>
                    <strong style="font-size: 16px;">ĐẶT IN THÀNH CÔNG</strong>
                </div>
                <span class="badge status-available">Đã Tiếp Nhận</span>
            </div>
            <div class="card-body p-4">
                <div class="row align-items-center mb-4">
                    <div class="col-md-7">
                        <p class="text-muted mb-1" style="font-size: 13px;">Mã đơn hàng chính thức của bạn:</p>
                        <div class="d-flex align-items-center gap-2">
                            <span class="mono" style="font-size: 24px; font-weight: 700; color: var(--intent-action-base);">
                                @Model.CreatedOrder.OrderCode
                            </span>
                            <button class="btn btn-secondary btn-sm" onclick="navigator.clipboard.writeText('@Model.CreatedOrder.OrderCode'); alert('Đã sao chép mã đơn hàng!');">
                                <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="stroke-shape" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                                Sao chép
                            </button>
                        </div>
                        <p class="text-success small mt-2 mb-0" style="font-weight: 500;">
                            Giá đã được chốt cố định theo bảng giá tại thời điểm tạo đơn và không phát sinh phụ phí.
                        </p>
                    </div>
                    <div class="col-md-5 text-md-end mt-3 mt-md-0">
                        <span class="text-muted d-block small" style="font-weight: 500;">Tổng chi phí thanh toán cố định:</span>
                        <span class="mono" style="font-size: 26px; font-weight: 700; color: var(--intent-action-base);">
                            @Model.CreatedOrder.TotalPrice.ToString("N0") VNĐ
                        </span>
                    </div>
                </div>

                <div class="table-container mb-3">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Tài liệu</th>
                                <th>Số bản in</th>
                                <th>Quy cách in</th>
                                <th>Mã nhận QR</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="font-weight: 600;">@Model.CreatedOrder.DocumentName</td>
                                <td class="mono">@Model.CreatedOrder.NumberOfCopies bản</td>
                                <td>
                                    <span class="badge status-neutral">
                                        @(Model.CreatedOrder.IsColor ? "In Màu" : "Trắng Đen") • @(Model.CreatedOrder.IsDoubleSided ? "2 Mặt" : "1 Mặt")
                                    </span>
                                </td>
                                <td><span class="mono font-monospace fw-bold" style="color: var(--intent-action-base);">@Model.CreatedOrder.QrToken</span></td>
                                <td><span class="badge status-pending">Chờ xử lý</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="alert alert-warning d-flex align-items-center mb-4 gap-2" role="alert">
                    <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M12 8v4M12 16h.01"/></svg>
                    <div>
                        <strong>Lưu ý:</strong> Khi nhân viên bắt đầu chạy máy in, hệ thống sẽ khóa chức năng hủy đơn để bảo vệ vật tư in ấn.
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-page="/Student/Orders" class="btn btn-action">
                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="bg-shape" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/><path class="stroke-shape" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                        Xem Đơn Hàng Của Tôi & Lấy Mã QR
                    </a>
                    <a asp-page="/Student/CreateOrder" class="btn btn-secondary">
                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M12 8v8M8 12h8"/></svg>
                        Tạo Đơn Đặt In Khác
                    </a>
                    <a asp-page="/Student/Documents" class="btn btn-secondary">
                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="bg-shape" d="M6 3h8l6 6v12H6z"/><path class="stroke-shape" d="M14 3v6h6M6 3h8l6 6v12a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2zM9 13h6M9 17h4"/></svg>
                        Xem Kho Tài Liệu
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- 2-Column Student Document Studio Layout -->
        <div class="row g-4">
            <!-- Left Column: Document & Print Configuration Form (Preserved 100% controls) -->
            <div class="col-lg-7">
                <div class="card craft-card print-registered p-4">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                        <span class="badge status-neutral">1</span>
                        <strong style="font-size: 15px; color: var(--text-heading);">Chọn Tài Liệu & Cấu Hình In</strong>
                    </div>

                    <form method="post" id="createOrderForm">
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label mb-0" for="documentId">Tài liệu cần in <span class="text-danger">*</span></label>
                                <a asp-page="/Student/Documents" class="text-decoration-none small d-inline-flex align-items-center gap-1" style="font-size: 12.5px; font-weight: 600; color: var(--intent-action-base);">
                                    <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="stroke-shape" d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                                    Tải file mới / Kho tài liệu
                                </a>
                            </div>

                            @if (Model.MyDocuments.Any())
                            {
                                <div class="input-group">
                                    <select asp-for="DocumentId" class="form-select mono" id="documentId" required>
                                        <option value="">-- Chọn tài liệu từ kho cá nhân --</option>
                                        @foreach (var doc in Model.MyDocuments)
                                        {
                                            <option value="@doc.Id" data-pages="@doc.PageCount" data-filename="@doc.FileName" selected="@(doc.Id == Model.DocumentId)">
                                                @doc.FileName (@doc.PageCount trang)
                                            </option>
                                        }
                                    </select>
                                    <a asp-page="/Student/Documents" class="btn btn-secondary" title="Quản lý hoặc đổi sang tài liệu khác">
                                        Đổi file khác
                                    </a>
                                </div>

                                <div id="selectedDocInfoPanel" class="tonal-panel d-flex justify-content-between align-items-center py-2 px-3 mt-2" style="background-color: var(--intent-action-tint); border-color: var(--intent-action-border); @(Model.DocumentId.HasValue ? "" : "display: none !important;")">
                                    <div class="d-flex align-items-center gap-2">
                                        <svg class="icon-duotone icon-sm" style="color: var(--intent-action-base);" viewBox="0 0 24 24"><path class="bg-shape" d="M6 3h8l6 6v12H6z"/><path class="stroke-shape" d="M14 3v6h6M6 3h8l6 6v12a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2z"/></svg>
                                        <span style="font-size: 13.5px; color: var(--intent-action-base);">
                                            Tài liệu đang chọn: <strong id="selectedDocNameText">@(Model.SelectedDocumentName ?? "")</strong>
                                        </span>
                                    </div>
                                    <span class="badge status-available mono" id="selectedDocPagesBadge">@Model.PageCount trang</span>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-3 mb-0" style="font-size: 13px;">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M12 8v4M12 16h.01"/></svg>
                                        <strong>Kho tài liệu cá nhân đang trống!</strong>
                                    </div>
                                    <p class="mb-2 text-muted">Bạn cần tải lên tệp PDF hoặc DOCX để hệ thống tự động trích xuất số trang in chuẩn và cố định giá in.</p>
                                    <a asp-page="/Student/Documents" class="btn btn-action btn-sm">
                                        <svg class="icon-duotone icon-sm me-1" viewBox="0 0 24 24"><path class="stroke-shape" d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                                        Tải lên tài liệu ngay
                                    </a>
                                </div>
                            }
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Số trang in (Tự động đọc)</label>
                                <input asp-for="PageCount" id="pageCount" class="form-control mono" type="number" min="1" readonly />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Số bản in (Copies)</label>
                                <input asp-for="NumberOfCopies" id="numberOfCopies" class="form-control mono" type="number" min="1" value="1" />
                            </div>
                        </div>

                        <!-- Print Options Checklist -->
                        <div class="tonal-panel mb-3 p-3">
                            <div class="text-muted small mb-2" style="font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                                Tùy chọn gia công & mặt in
                            </div>
                            <div class="form-check mb-2">
                                <input asp-for="IsColor" class="form-check-input option-trigger" type="checkbox" id="isColor" />
                                <label class="form-check-label" for="isColor" style="font-size: 13.5px;">In màu chất lượng cao (Mặc định: In đen trắng)</label>
                            </div>
                            <div class="form-check mb-2">
                                <input asp-for="IsDoubleSided" class="form-check-input option-trigger" type="checkbox" id="isDoubleSided" checked />
                                <label class="form-check-label" for="isDoubleSided" style="font-size: 13.5px;">In hai mặt (Tiết kiệm 10% chi phí giấy)</label>
                            </div>
                            <div class="form-check mb-2">
                                <input asp-for="HasBinding" class="form-check-input option-trigger" type="checkbox" id="hasBinding" />
                                <label class="form-check-label" for="hasBinding" style="font-size: 13.5px;">Đóng gáy sách (+5.000 VNĐ / bản)</label>
                            </div>
                            <div class="form-check mb-0">
                                <input asp-for="HasStaple" class="form-check-input option-trigger" type="checkbox" id="hasStaple" checked />
                                <label class="form-check-label" for="hasStaple" style="font-size: 13.5px;">Bấm kim góc (+1.000 VNĐ / bản)</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phương thức thanh toán</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="@PaymentMethod.Cash">Tiền mặt tại quầy (Cash)</option>
                                <option value="@PaymentMethod.VietQR_PayOS">Chuyển khoản VietQR / PayOS</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Ghi chú cho trạm in (Tùy chọn)</label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ví dụ: Cần gấp trước giờ học, bấm kim 2 đầu mép trái..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-action w-100 py-2" id="submitBtn" @(!Model.DocumentId.HasValue ? "disabled" : "")>
                            <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M8 12l3 3 5-5"/></svg>
                            Xác Nhận & Gửi Lệnh In
                        </button>
                    </form>
                </div>
            </div>

            <!-- Right Column: Sticky Transparent Electronic Receipt -->
            <div class="col-lg-5">
                <div style="position: sticky; top: 76px;">
                    <div class="card craft-card print-registered p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                            <div class="d-flex align-items-center gap-2">
                                <svg class="icon-duotone icon-sm" style="color: var(--intent-action-base);" viewBox="0 0 24 24"><path class="stroke-shape" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                <strong style="font-size: 15px; color: var(--text-heading);">Bảng Tính Chi Phí Cố Định</strong>
                            </div>
                            <span class="badge status-available">Minh Bạch</span>
                        </div>

                        <div class="tonal-panel mb-3 p-3">
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Đơn giá trang in:</span>
                                <span class="mono fw-bold" id="lblUnitPrice">@(Model.EstimatedPrice != null ? Model.EstimatedPrice.UnitPricePerPage.ToString("N0") : "315") VNĐ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Thành tiền trang in:</span>
                                <span class="mono fw-bold" id="lblPageSubtotal">@(Model.EstimatedPrice != null ? Model.EstimatedPrice.PageSubtotal.ToString("N0") : "3.150") VNĐ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small">
                                <span class="text-muted">Gia công (Gáy / Kim):</span>
                                <span class="mono fw-bold" id="lblExtraServices">@(Model.EstimatedPrice != null ? Model.EstimatedPrice.ExtraServicesTotal.ToString("N0") : "1.000") VNĐ</span>
                            </div>
                            <div class="border-top my-2 pt-2 d-flex justify-content-between align-items-baseline" style="border-color: var(--border-subtle) !important;">
                                <strong style="color: var(--text-heading); font-size: 14px;">Tổng cộng:</strong>
                                <span class="mono" style="font-size: 24px; font-weight: 700; color: var(--intent-action-base);" id="lblTotalPrice">
                                    @(Model.EstimatedPrice != null ? Model.EstimatedPrice.TotalEstimatedPrice.ToString("N0") : "4.150") VNĐ
                                </span>
                            </div>
                        </div>

                        <div class="tonal-panel p-3" style="font-size: 12px; color: var(--text-muted);">
                            <div class="mb-1" style="font-weight: 600; color: var(--text-heading);">Bảng giá niêm yết hiện hành:</div>
                            <ul class="mb-0 ps-3 d-flex flex-column gap-1">
                                <li>Trang đen trắng: <strong>350đ / trang</strong></li>
                                <li>Trang in màu: <strong>1.500đ / trang</strong></li>
                                <li>In 2 mặt: Giảm ngay <strong>10%</strong> trên đơn giá trang</li>
                                <li>Bấm kim: <strong>1.000đ / bản</strong> · Đóng gáy: <strong>5.000đ / bản</strong></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const docIdEl = document.getElementById('documentId');
            const pageCountEl = document.getElementById('pageCount');
            const copiesEl = document.getElementById('numberOfCopies');
            const colorEl = document.getElementById('isColor');
            const doubleSidedEl = document.getElementById('isDoubleSided');
            const bindingEl = document.getElementById('hasBinding');
            const stapleEl = document.getElementById('hasStaple');
            const submitBtn = document.getElementById('submitBtn');
            const selectedDocInfoPanel = document.getElementById('selectedDocInfoPanel');
            const selectedDocNameText = document.getElementById('selectedDocNameText');
            const selectedDocPagesBadge = document.getElementById('selectedDocPagesBadge');

            function updatePriceRealtime() {
                const docId = docIdEl ? docIdEl.value : '';
                if (!docId) return;

                const copies = copiesEl ? (parseInt(copiesEl.value) || 1) : 1;
                const isColor = colorEl ? colorEl.checked : false;
                const isDoubleSided = doubleSidedEl ? doubleSidedEl.checked : false;
                const hasBinding = bindingEl ? bindingEl.checked : false;
                const hasStaple = stapleEl ? stapleEl.checked : false;

                const url = `/Student/CreateOrder?handler=CalculatePrice&documentId=${encodeURIComponent(docId)}&copies=${copies}&isColor=${isColor}&isDoubleSided=${isDoubleSided}&hasBinding=${hasBinding}&hasStaple=${hasStaple}`;

                fetch(url)
                    .then(res => res.json())
                    .then(result => {
                        if (result && result.success && result.data) {
                            const data = result.data;
                            const fmt = (num) => new Intl.NumberFormat('vi-VN').format(num) + ' VNĐ';
                            document.getElementById('lblUnitPrice').innerText = fmt(data.unitPricePerPage);
                            document.getElementById('lblPageSubtotal').innerText = fmt(data.pageSubtotal);
                            document.getElementById('lblExtraServices').innerText = fmt(data.extraServicesTotal);
                            document.getElementById('lblTotalPrice').innerText = fmt(data.totalEstimatedPrice);
                        }
                    })
                    .catch(err => console.error('Price calculation error:', err));
            }

            function handleDocumentSelectionChange() {
                if (!docIdEl) return;
                const selectedOption = docIdEl.options[docIdEl.selectedIndex];
                if (selectedOption && selectedOption.value) {
                    const pages = parseInt(selectedOption.getAttribute('data-pages')) || 1;
                    const filename = selectedOption.getAttribute('data-filename') || selectedOption.text;
                    if (pageCountEl) pageCountEl.value = pages;
                    if (selectedDocNameText) selectedDocNameText.innerText = filename;
                    if (selectedDocPagesBadge) selectedDocPagesBadge.innerText = pages + ' trang';
                    if (selectedDocInfoPanel) selectedDocInfoPanel.style.display = 'flex';
                    if (submitBtn) submitBtn.disabled = false;
                    updatePriceRealtime();
                } else {
                    if (selectedDocInfoPanel) selectedDocInfoPanel.style.display = 'none';
                    if (submitBtn) submitBtn.disabled = true;
                }
            }

            if (docIdEl) {
                docIdEl.addEventListener('change', handleDocumentSelectionChange);
            }

            const triggers = document.querySelectorAll('.option-trigger, #numberOfCopies');
            triggers.forEach(el => {
                el.addEventListener('change', updatePriceRealtime);
                el.addEventListener('input', updatePriceRealtime);
            });

            if (docIdEl && docIdEl.value) {
                handleDocumentSelectionChange();
            }
        });
    </script>
}
