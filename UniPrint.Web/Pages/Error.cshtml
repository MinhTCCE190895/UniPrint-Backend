@page
@model ErrorModel
@{
    // [UI Presentation Only] - Tiêu đề trang thông báo sự cố
    ViewData["Title"] = "Thông Báo Sự Cố";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card p-4 p-md-5">
            <div class="mb-3">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 56px; height: 56px; background-color: var(--intent-danger-tint); color: var(--intent-danger-base);">
                    <svg class="icon-duotone icon-lg" viewBox="0 0 24 24">
                        <circle class="bg-shape" cx="12" cy="12" r="10"/>
                        <path class="stroke-shape" d="M12 8v4M12 16h.01"/>
                    </svg>
                </span>
            </div>
            <h3 class="mb-2" style="font-weight: 700; color: var(--text-heading);">Đã Xảy Ra Sự Cố Không Mong Muốn</h3>
            <p class="text-muted small mb-4">
                Hệ thống trạm in không thể xử lý yêu cầu này lúc này. Vui lòng kiểm tra lại kết nối hoặc quay lại trang chủ.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="p-2 mb-4 rounded mono text-muted small" style="background-color: var(--surface-subtle); border: 1px solid var(--border-subtle);">
                    Mã truy vết sự cố (Request ID): <strong>@Model.RequestId</strong>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-page="/Index" class="btn btn-primary">
                    <svg class="icon-duotone icon-sm" viewBox="0 0 24 24">
                        <path class="bg-shape" d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                        <path class="stroke-shape" d="M9 22V12h6v10"/>
                    </svg>
                    Về Trang Chủ Trạm In
                </a>
                <button type="button" onclick="history.back()" class="btn btn-outline">
                    Quay Lại Trang Trước
                </button>
            </div>
        </div>
    </div>
</div>
