@page
@model UniPrint.Web.Pages.Staff.QueueModel
@{
    ViewData["Title"] = "Hàng Đợi In Ấn - Staff";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-list-task"></i> HÀNG ĐỢI XỬ LÝ IN ẤN (STAFF QUEUE)</h2>
        <div>
            <span class="badge bg-warning text-dark fs-6 me-2">Đang chờ xử lý in: @Model.Orders.Count(o => o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.Pending || o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.Processing || o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.Printing)</span>
            <span class="badge bg-success fs-6">Đã in xong (Chờ lấy): @Model.Orders.Count(o => o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.ReadyForPickup)</span>
        </div>
    </div>
    <hr />

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-hover shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã Đơn</th>
                    <th>Thời Gian Đặt (FIFO)</th>
                    <th>Sinh Viên</th>
                    <th>Tài Liệu</th>
                    <th>Cấu Hình</th>
                    <th>Tổng Tiền</th>
                    <th>Trạng Thái</th>
                    <th>Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">Hiện không có đơn nào đang chờ in.</td>
                    </tr>
                }
                @foreach (var o in Model.Orders)
                {
                    <tr>
                        <td><code>@o.OrderCode</code></td>
                        <td>
                            <small class="text-muted"><i class="bi bi-clock"></i> @o.CreatedAt.ToLocalTime().ToString("HH:mm:ss dd/MM")</small>
                        </td>
                        <td>@o.StudentName</td>
                        <td>@o.DocumentName</td>
                        <td>
                            @(o.IsColor ? "Màu" : "Trắng đen"), @(o.IsDoubleSided ? "2 mặt" : "1 mặt")
                        </td>
                        <td><strong>@o.TotalPrice.ToString("N0") VNĐ</strong></td>
                        <td>
                            @switch (o.Status)
                            {
                                case UniPrint.DataAccess.Enums.PrintOrderStatus.Pending:
                                    <span class="badge bg-secondary">Chờ tiếp nhận</span>
                                    break;
                                case UniPrint.DataAccess.Enums.PrintOrderStatus.Processing:
                                    <span class="badge bg-warning text-dark">Đã tiếp nhận</span>
                                    break;
                                case UniPrint.DataAccess.Enums.PrintOrderStatus.Printing:
                                    <span class="badge bg-primary">Đang in</span>
                                    break;
                                case UniPrint.DataAccess.Enums.PrintOrderStatus.ReadyForPickup:
                                    <span class="badge bg-success">Chờ nhận đồ</span>
                                    break;
                                default:
                                    <span class="badge bg-info text-dark">@o.StatusText</span>
                                    break;
                            }
                            @if (!string.IsNullOrEmpty(o.ShelfCode))
                            {
                                <div class="mt-1">
                                    <span class="badge bg-light text-primary border border-primary">
                                        <i class="bi bi-inboxes"></i> Kệ: @o.ShelfCode
                                    </span>
                                </div>
                            }
                        </td>
                        <td>
                            @if (o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.Pending)
                            {
                                <form method="post" asp-page-handler="UpdateStatus" asp-route-orderId="@o.Id" asp-route-newStatus="@UniPrint.DataAccess.Enums.PrintOrderStatus.Processing" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Tiếp nhận đơn</button>
                                </form>
                            }
                            else if (o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.Processing)
                            {
                                <form method="post" asp-page-handler="UpdateStatus" asp-route-orderId="@o.Id" asp-route-newStatus="@UniPrint.DataAccess.Enums.PrintOrderStatus.Printing" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Bắt đầu in</button>
                                </form>
                            }
                            else if (o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.Printing)
                            {
                                @if (Model.AvailableShelves.Count > 0)
                                {
                                    <form method="post" asp-page-handler="AssignShelf" asp-route-orderId="@o.Id" class="d-inline-flex align-items-center">
                                        <select name="shelfId" class="form-select form-select-sm me-1" style="width: 140px;" required>
                                            <option value="">-- Chọn Kệ --</option>
                                            @foreach (var shelf in Model.AvailableShelves)
                                            {
                                                <option value="@shelf.Id">Kệ @shelf.ShelfCode (@(shelf.MaxCapacity - shelf.CurrentCount) chỗ)</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-success text-nowrap">
                                            <i class="bi bi-box-arrow-in-down"></i> In xong & Xếp kệ
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="UpdateStatus" asp-route-orderId="@o.Id" asp-route-newStatus="@UniPrint.DataAccess.Enums.PrintOrderStatus.ReadyForPickup" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success">Đã in xong</button>
                                    </form>
                                }
                            }
                            else if (o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.ReadyForPickup)
                            {
                                @if (string.IsNullOrEmpty(o.ShelfCode) && Model.AvailableShelves.Count > 0)
                                {
                                    <form method="post" asp-page-handler="AssignShelf" asp-route-orderId="@o.Id" class="d-inline-flex align-items-center">
                                        <select name="shelfId" class="form-select form-select-sm me-1" style="width: 130px;" required>
                                            <option value="">-- Chọn Kệ --</option>
                                            @foreach (var shelf in Model.AvailableShelves)
                                            {
                                                <option value="@shelf.Id">Kệ @shelf.ShelfCode</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary text-nowrap">Xếp kệ</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-success small fw-semibold"><i class="bi bi-check2-circle"></i> Chờ sinh viên quét QR</span>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
