@page
@model UniPrint.Web.Pages.StudyHub.IndexModel
@{
    ViewData["Title"] = "Study Hub - Kho Tài Liệu Học Tập";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-book"></i> STUDY HUB - KHO TÀI LIỆU HỌC TẬP</h2>
        <span class="badge bg-success fs-6">Đã kiểm duyệt: @Model.Materials.Count</span>
    </div>
    <p class="text-muted">Kho chia sẻ tài liệu ôn thi, bài giảng và tóm tắt môn học do sinh viên đóng góp (Đã qua duyệt Admin).</p>
    <hr />

    <div class="row">
        @if (Model.Materials.Count == 0)
        {
            <div class="col-12 text-center py-5 text-muted">
                <h4>Chưa có tài liệu nào trong thư viện.</h4>
                <p>Hãy là người đầu tiên chia sẻ tài liệu hữu ích cho cộng đồng sinh viên!</p>
            </div>
        }
        @foreach (var m in Model.Materials)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <span class="badge bg-primary mb-2">@m.SubjectCode</span>
                        <span class="badge bg-secondary mb-2">@m.CategoryName</span>
                        <h5 class="card-title text-truncate">@m.Title</h5>
                        <p class="card-text text-muted small">@m.Description</p>
                        <div class="d-flex justify-content-between align-items-center mt-3 text-muted small">
                            <span>⭐ @m.AverageRating.ToString("F1") / 5</span>
                            <span>📥 @m.DownloadCount lượt tải</span>
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0">
                        <button class="btn btn-outline-primary btn-sm w-100">Xem Chi Tiết & Tải Về</button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
