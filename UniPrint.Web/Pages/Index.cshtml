@page
@model IndexModel
@{
    ViewData["Title"] = "Trang Chủ";
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 60%, #084298 100%);
        color: #fff;
        padding: 80px 0 60px;
        margin: -1.5rem -12px 2rem;
        text-align: center;
        border-radius: 0 0 24px 24px;
    }
    .hero-section h1 {
        font-size: 2.8rem;
        font-weight: 800;
        letter-spacing: -0.5px;
    }
    .hero-section p {
        font-size: 1.15rem;
        opacity: .85;
        max-width: 520px;
        margin: 0 auto 2rem;
    }
    .feature-card {
        border: none;
        border-radius: 16px;
        transition: transform .2s, box-shadow .2s;
        cursor: default;
        height: 100%;
    }
    .feature-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 12px 32px rgba(0,0,0,.12) !important;
    }
    .feature-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        margin-bottom: 1rem;
    }
</style>

<!-- Hero -->
<div class="hero-section shadow-sm">
    <h1>UniPrint Platform</h1>
    <p>Hệ thống in ấn thông minh dành cho sinh viên — nhanh chóng, tiện lợi, không cần xếp hàng.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            @if (User.IsInRole("Student"))
            {
                <a asp-page="/Student/CreateOrder" class="btn btn-warning btn-lg fw-semibold px-4">Đặt In Ngay</a>
                <a asp-page="/Student/Documents" class="btn btn-outline-light btn-lg px-4">Tài Liệu Của Tôi</a>
            }
            @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
            {
                <a asp-page="/Staff/Queue" class="btn btn-warning btn-lg fw-semibold px-4">Xem Hàng Đợi In</a>
                <a asp-page="/Pickup/ScanQR" class="btn btn-outline-light btn-lg px-4">Quét QR Nhận Hàng</a>
            }
        </div>
    }
    else
    {
        <div class="d-flex gap-3 justify-content-center flex-wrap">
            <a asp-page="/Auth/Login" class="btn btn-warning btn-lg fw-semibold px-4">Đăng Nhập</a>
            <a asp-page="/Auth/Register" class="btn btn-outline-light btn-lg px-4">Tạo Tài Khoản</a>
        </div>
    }

</div>

<!-- Feature Cards -->
<div class="row g-4">
    <div class="col-md-4">
        <div class="card feature-card shadow-sm p-4">
            <div class="feature-icon bg-primary bg-opacity-10">🖨️</div>
            <h5 class="fw-bold mb-2">Đặt In Trực Tuyến</h5>
            <p class="text-muted mb-3">Tải tài liệu lên, chọn số bản, khổ giấy, và đặt lịch nhận — mọi thứ chỉ trong vài cú click.</p>
            @if (User.IsInRole("Student"))
            {
                <a asp-page="/Student/CreateOrder" class="btn btn-primary btn-sm mt-auto">Đặt In Ngay →</a>
            }
        </div>
    </div>
    <div class="col-md-4">
        <div class="card feature-card shadow-sm p-4">
            <div class="feature-icon bg-success bg-opacity-10">📁</div>
            <h5 class="fw-bold mb-2">Quản Lý Tài Liệu</h5>
            <p class="text-muted mb-3">Lưu trữ và xem lại toàn bộ tài liệu đã tải lên. Theo dõi trạng thái đơn in theo thời gian thực.</p>
            @if (User.IsInRole("Student"))
            {
                <a asp-page="/Student/Documents" class="btn btn-success btn-sm mt-auto">Xem Tài Liệu →</a>
            }
        </div>
    </div>
    <div class="col-md-4">
        <div class="card feature-card shadow-sm p-4">
            <div class="feature-icon bg-warning bg-opacity-10">📚</div>
            <h5 class="fw-bold mb-2">Study Hub</h5>
            <p class="text-muted mb-3">Kho tài liệu học tập được chia sẻ bởi cộng đồng sinh viên — tìm kiếm và tải về miễn phí.</p>
            <a asp-page="/StudyHub/Index" class="btn btn-warning btn-sm mt-auto text-dark">Khám Phá →</a>
        </div>
    </div>
</div>

<!-- How it works -->
<div class="mt-5 pt-2">
    <h4 class="fw-bold mb-4 text-center">Cách hoạt động</h4>
    <div class="row g-3 text-center">
        <div class="col-md-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width:48px;height:48px;font-weight:700;">1</div>
            <h6 class="fw-semibold">Tải tài liệu lên</h6>
            <p class="text-muted small">PDF, DOCX, XLSX... đều được hỗ trợ</p>
        </div>
        <div class="col-md-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width:48px;height:48px;font-weight:700;">2</div>
            <h6 class="fw-semibold">Chọn thông số in</h6>
            <p class="text-muted small">Số bản, khổ giấy, 1 mặt / 2 mặt</p>
        </div>
        <div class="col-md-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width:48px;height:48px;font-weight:700;">3</div>
            <h6 class="fw-semibold">Nhân viên xử lý</h6>
            <p class="text-muted small">Đơn vào hàng đợi, in tự động</p>
        </div>
        <div class="col-md-3">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3" style="width:48px;height:48px;font-weight:700;">4</div>
            <h6 class="fw-semibold">Quét QR nhận hàng</h6>
            <p class="text-muted small">Đến điểm nhận, quét mã và lấy tài liệu</p>
        </div>
    </div>
</div>
