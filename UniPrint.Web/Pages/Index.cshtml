@page
@model IndexModel
@{
    ViewData["Title"] = "Trang Chủ - UniPrint Station";
    
    // [UI Presentation Only] Lọc nhanh đơn in đang hoạt động của sinh viên
    var activePickupOrder = Model.RecentOrders.FirstOrDefault(o => o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.ReadyForPickup);
    var activePrintingOrder = Model.RecentOrders.FirstOrDefault(o => o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.Printing || o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.Processing || o.Status == UniPrint.DataAccess.Enums.PrintOrderStatus.Pending);
}

<div class="mt-3">
    @if (User.Identity?.IsAuthenticated == true)
    {
        @if (User.IsInRole("Student"))
        {
            <!-- ==================================================================
                 ROLE 1: STUDENT HOME (TỐI GIẢN · THOÁNG ĐÃNG · TẬP TRUNG HỌC TẬP)
                 Thiết kế loại bỏ toàn bộ các khối hộp rườm rà, tập trung 100% vào việc in ấn
                 ================================================================== -->
            <div class="py-2" style="max-width: 1040px; margin: 0 auto;">
                <!-- Header Lời Chào Nhẹ Nhàng -->
                <div class="d-flex justify-content-between align-items-baseline mb-4 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <div>
                        <h1 style="font-size: 1.85rem; font-weight: 400; color: var(--text-heading); letter-spacing: -0.3px;" class="mb-1 font-editorial">
                            Xin chào, @User.Identity.Name
                        </h1>
                        <p class="text-muted mb-0" style="font-size: 13.5px;">
                            Trạm in trực tuyến sẵn sàng phục vụ học tập và nghiên cứu.
                        </p>
                    </div>
                    <span class="badge status-available mono" style="font-size: 11px;">
                        ● Sẵn sàng phục vụ
                    </span>
                </div>

                <!-- Alert Đơn Hàng Sẵn Sàng Nhận (Chỉ hiện khi thực sự có đơn sẵn sàng trên kệ) -->
                @if (activePickupOrder != null)
                {
                    <div class="p-3 mb-4 rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-2" style="background-color: var(--intent-confirm-tint); border: 1px solid var(--intent-confirm-border);">
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 36px; height: 36px; background-color: var(--surface-card); color: var(--intent-confirm-base); border: 1px solid var(--intent-confirm-border);">
                                <svg class="icon-duotone icon-md" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="12" r="9"/><path class="stroke-shape" d="M8 12l3 3 5-5"/></svg>
                            </span>
                            <div>
                                <div style="font-size: 13.5px; font-weight: 600; color: var(--text-heading);">
                                    Đơn in #@activePickupOrder.OrderCode (@activePickupOrder.DocumentName) đã in xong!
                                </div>
                                <div class="text-muted small" style="font-size: 12px;">
                                    Vị trí lưu: <strong class="text-dark">Kệ @activePickupOrder.ShelfCode</strong> · Đến quầy mở mã QR để nhận bản in ngay.
                                </div>
                            </div>
                        </div>
                        <a asp-page="/Student/Orders" class="btn btn-confirm btn-sm">
                            Xem Mã QR Nhận Hàng →
                        </a>
                    </div>
                }
                else if (activePrintingOrder != null)
                {
                    <div class="p-3 mb-4 rounded-3 d-flex justify-content-between align-items-center flex-wrap gap-2" style="background-color: var(--surface-subtle); border: 1px solid var(--border-card);">
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 34px; height: 34px; background-color: var(--surface-card); color: var(--intent-action-base); border: 1px solid var(--border-card);">
                                <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="bg-shape" d="M6 9h12v9H6z"/><path class="stroke-shape" d="M6 9V3h12v6M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v7H6z"/></svg>
                            </span>
                            <div style="font-size: 13px; color: var(--text-heading);">
                                Đơn in <strong>#@activePrintingOrder.OrderCode</strong> (@activePrintingOrder.DocumentName) đang được xử lý in tại quầy...
                            </div>
                        </div>
                        <a asp-page="/Student/Orders" class="btn btn-secondary btn-sm">
                            Chi Tiết →
                        </a>
                    </div>
                }

                <!-- Trọng Tâm: Khối Đặt In Tinh Gọn (Single Clean Focus, Zero Box Clutter) -->
                <div class="card craft-card print-registered p-4 p-md-5 mb-4 rounded-3 text-center">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 48px; height: 48px; background-color: var(--surface-subtle); color: var(--intent-action-base); border: 1px solid var(--border-card);">
                        <svg class="icon-duotone icon-md" viewBox="0 0 24 24">
                            <path class="bg-shape" d="M6 9h12v9H6z"/>
                            <path class="stroke-shape" d="M6 9V3h12v6M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v7H6z"/>
                        </svg>
                    </div>

                    <h2 style="font-size: 1.45rem; font-weight: 700; color: var(--text-heading); letter-spacing: -0.3px;" class="mb-2">
                        Bắt Đầu Đặt In Tài Liệu Mới
                    </h2>
                    <p class="text-muted mx-auto mb-4" style="max-width: 580px; font-size: 14px; line-height: 1.55;">
                        Tải file PDF hoặc Word lên hệ thống. Tự động đếm số trang, giảm giá 10% khi in hai mặt và chốt phí minh bạch tức thì.
                    </p>

                    <div class="d-flex justify-content-center gap-2 flex-wrap mb-3">
                        <a asp-page="/Student/CreateOrder" class="btn btn-action px-4 py-2" style="font-size: 14px; font-weight: 600;">
                            <svg class="icon-duotone icon-sm me-1" viewBox="0 0 24 24"><path class="bg-shape" d="M6 9h12v9H6z"/><path class="stroke-shape" d="M6 9V3h12v6M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v7H6z"/></svg>
                            Đặt In Tài Liệu Ngay →
                        </a>
                        <a asp-page="/Student/Orders" class="btn btn-secondary px-3 py-2" style="font-size: 13.5px;">
                            <svg class="icon-duotone icon-sm me-1" viewBox="0 0 24 24"><path class="bg-shape" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/><path class="stroke-shape" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                            Đơn Hàng Của Tôi
                        </a>
                        <a asp-page="/Student/Documents" class="btn btn-secondary px-3 py-2" style="font-size: 13.5px;">
                            <svg class="icon-duotone icon-sm me-1" viewBox="0 0 24 24"><path class="bg-shape" d="M6 3h8l6 6v12H6z"/><path class="stroke-shape" d="M14 3v6h6M6 3h8l6 6v12a2 2 0 01-2 2H6a2 2 0 01-2-2V5a2 2 0 012-2zM9 13h6M9 17h4"/></svg>
                            Kho Tệp Đã Lưu (@Model.TotalDocuments)
                        </a>
                        <a asp-page="/StudyHub/Index" class="btn btn-secondary px-3 py-2" style="font-size: 13.5px;">
                            <svg class="icon-duotone icon-sm me-1" viewBox="0 0 24 24"><path class="bg-shape" d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path class="stroke-shape" d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
                            Study Hub
                        </a>
                    </div>

                    <div class="d-flex justify-content-center align-items-center gap-3 text-muted small pt-2 border-top" style="border-color: var(--border-subtle) !important; font-size: 12px;">
                        <span>Đen trắng: <strong>350 đ/trang</strong></span>
                        <span>·</span>
                        <span>In màu: <strong>1.500 đ/trang</strong></span>
                        <span>·</span>
                        <span style="color: var(--intent-confirm-base); font-weight: 600;">Giảm 10% in hai mặt</span>
                        <span>·</span>
                        <span>Nhận hàng qua QR tại quầy</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- ==================================================================
                 ROLE 2: STAFF / ADMIN DISPATCH CONSOLE (BÀN ĐIỀU PHỐI NHÂN VIÊN)
                 ================================================================== -->
            <div class="py-2">
                <!-- Staff Header & Shift Status -->
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 pb-3 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <div>
                        <h1 class="mb-1" style="font-size: 1.75rem; font-weight: 700; color: var(--text-heading); letter-spacing: -0.3px;">
                            Bàn Điều Phối Trạm In
                        </h1>
                        <div class="text-muted small d-flex align-items-center gap-2">
                            <span>Nhân viên trực ca: <strong>@User.Identity.Name</strong></span>
                            <span style="opacity: 0.3;">·</span>
                            <span class="badge status-available mono" style="font-size: 11px;">Trạm điều phối trực tuyến</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-page="/Staff/Queue" class="btn btn-action">
                            <svg class="icon-duotone icon-sm me-1" viewBox="0 0 24 24"><path class="bg-shape" d="M4 6h16v14H4z"/><path class="stroke-shape" d="M6 2v4M18 2v4M4 6h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2zM4 11h16M8 15h8"/></svg>
                            Hàng Đợi In
                        </a>
                        <a asp-page="/Staff/Shelves" class="btn btn-secondary">
                            <svg class="icon-duotone icon-sm me-1" viewBox="0 0 24 24"><path class="bg-shape" d="M4 6h16v12H4z"/><path class="stroke-shape" d="M3 6h18M3 12h18M3 18h18M4 6v12M20 6v12"/></svg>
                            Quản Lý Kệ
                        </a>
                        <a asp-page="/Pickup/ScanQR" class="btn btn-confirm">
                            <svg class="icon-duotone icon-sm me-1" viewBox="0 0 24 24"><path class="bg-shape" d="M4 4h6v6H4zm10 0h6v6h-6zm0 10h6v6h-6zm-10 0h6v6H4z"/><path class="stroke-shape" d="M3 3h8v8H3zM13 3h8v8h-8zM13 13h8v8h-8zM3 13h8v8H3z"/></svg>
                            Quét QR Trả Đồ
                        </a>
                    </div>
                </div>

                <!-- 3 Operational Command Tiles -->
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <div class="p-4 rounded-3 h-100 d-flex flex-column justify-content-between" style="background-color: var(--surface-card); border: 1px solid var(--border-card); box-shadow: var(--shadow-sm);">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-2" style="width: 36px; height: 36px; background-color: var(--surface-subtle); border: 1px solid var(--border-card); color: var(--intent-action-base);">
                                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="bg-shape" d="M4 6h16v14H4z"/><path class="stroke-shape" d="M6 2v4M18 2v4M4 6h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V8a2 2 0 012-2zM4 11h16M8 15h8"/></svg>
                                    </span>
                                    <span class="badge status-pending mono" style="font-size: 11px;">1. TIẾP NHẬN IN</span>
                                </div>
                                <strong style="font-size: 15px; color: var(--text-heading); display: block;" class="mb-2">Hàng Đợi Xử Lý In</strong>
                                <p class="text-muted small mb-3" style="font-size: 12.5px; line-height: 1.45;">
                                    Tiếp nhận và in đơn theo thứ tự thời gian đặt (FIFO). Kiểm tra quy cách in màu hoặc đen trắng và nạp máy in.
                                </p>
                            </div>
                            <a asp-page="/Staff/Queue" class="btn btn-action btn-sm w-100">
                                Mở Hàng Đợi In →
                            </a>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-4 rounded-3 h-100 d-flex flex-column justify-content-between" style="background-color: var(--surface-card); border: 1px solid var(--border-card); box-shadow: var(--shadow-sm);">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-2" style="width: 36px; height: 36px; background-color: var(--surface-subtle); border: 1px solid var(--border-card); color: var(--intent-action-base);">
                                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="bg-shape" d="M4 6h16v12H4z"/><path class="stroke-shape" d="M3 6h18M3 12h18M3 18h18M4 6v12M20 6v12"/></svg>
                                    </span>
                                    <span class="badge status-available mono" style="font-size: 11px;">2. SƠ ĐỒ LƯU</span>
                                </div>
                                <strong style="font-size: 15px; color: var(--text-heading); display: block;" class="mb-2">Quản Lý Kệ Lưu Trữ</strong>
                                <p class="text-muted small mb-3" style="font-size: 12.5px; line-height: 1.45;">
                                    Kiểm tra tỷ lệ lấp đầy của các ngăn kệ (A1, A2, B1...), thêm kệ mới hoặc điều chỉnh sức chứa khi cần.
                                </p>
                            </div>
                            <a asp-page="/Staff/Shelves" class="btn btn-secondary btn-sm w-100">
                                Xem Sơ Đồ Ngăn Kệ →
                            </a>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="p-4 rounded-3 h-100 d-flex flex-column justify-content-between" style="background-color: var(--surface-card); border: 1px solid var(--border-card); box-shadow: var(--shadow-sm);">
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-2" style="width: 36px; height: 36px; background-color: var(--surface-subtle); border: 1px solid var(--border-card); color: var(--intent-action-base);">
                                        <svg class="icon-duotone icon-sm" viewBox="0 0 24 24"><path class="bg-shape" d="M4 4h6v6H4zm10 0h6v6h-6zm0 10h6v6h-6zm-10 0h6v6H4z"/><path class="stroke-shape" d="M3 3h8v8H3zM13 3h8v8h-8zM13 13h8v8h-8zM3 13h8v8H3z"/></svg>
                                    </span>
                                    <span class="badge status-available mono" style="font-size: 11px;">3. ĐỐI SOÁT TRẢ</span>
                                </div>
                                <strong style="font-size: 15px; color: var(--text-heading); display: block;" class="mb-2">Quét QR Trả Hàng</strong>
                                <p class="text-muted small mb-3" style="font-size: 12.5px; line-height: 1.45;">
                                    Bật camera quét mã token từ điện thoại sinh viên để đối soát chính xác và tự động giải phóng vị trí kệ.
                                </p>
                            </div>
                            <a asp-page="/Pickup/ScanQR" class="btn btn-confirm btn-sm w-100">
                                Mở Trạm Quét QR →
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Shift Operational Guidelines -->
                <div class="p-3 rounded-3" style="background-color: var(--surface-card); border: 1px solid var(--border-card);">
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                        <strong style="font-size: 13.5px; color: var(--text-heading);">Quy Chuẩn Vận Hành Trạm In</strong>
                        <span class="mono small text-muted">Nguyên tắc FIFO</span>
                    </div>
                    <div class="row g-3 text-muted small" style="font-size: 12.5px;">
                        <div class="col-md-4">
                            <strong class="text-dark d-block mb-1">1. Thứ tự in:</strong> Chạy máy các đơn theo thời gian đặt sớm nhất để đảm bảo cam kết phục vụ.
                        </div>
                        <div class="col-md-4">
                            <strong class="text-dark d-block mb-1">2. Xếp đúng ngăn kệ:</strong> Sau khi hoàn tất in, xếp tài liệu vào đúng ngăn kệ đã lưu trên hệ thống.
                        </div>
                        <div class="col-md-4">
                            <strong class="text-dark d-block mb-1">3. Đối soát mã QR:</strong> Bắt buộc quét mã QR hoặc đối chiếu mã đơn trước khi trao tài liệu cho sinh viên tại quầy.
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <!-- ==================================================================
             ROLE 3: PUBLIC ACADEMIC PORTAL (HOME CHUNG CHO KHÁCH VÃNG LAI)
             Triết lý: Tinh tế · Tối giản · Tập trung chuyển đổi cao · Zero rườm rà
             ================================================================== -->
        <div class="py-4" style="max-width: 1040px; margin: 0 auto;">
            <!-- Hero Statement & Primary Conversion CTA -->
            <div class="card craft-card print-registered p-4 p-md-5 mb-4 rounded-3 text-center">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill" style="background-color: var(--surface-subtle); border: 1px solid var(--border-card); font-size: 11px; font-weight: 600; color: var(--intent-action-base);">
                    <span class="mono">UNIPRINT PLATFORM</span>
                    <span style="opacity: 0.3;">·</span>
                    <span>TRẠM IN ẤN HỌC THUẬT TRỰC TUYẾN</span>
                </div>

                <h1 style="font-size: 2.3rem; font-weight: 400; color: var(--text-heading); letter-spacing: -0.5px; line-height: 1.25;" class="mb-3 font-editorial">
                    In ấn thông minh, lấy tài liệu qua mã QR trong 3 giây.
                </h1>

                <p class="text-muted mx-auto mb-4" style="max-width: 620px; font-size: 14.5px; line-height: 1.6; font-weight: 500;">
                    Giải pháp in ấn học thuật dành cho sinh viên và giảng viên toàn trường. Tải tệp từ xa, tự động phân tích số trang, chốt giá cố định minh bạch và nhận bản in tại quầy không cần xếp hàng.
                </p>

                <div class="d-flex justify-content-center gap-2 flex-wrap mb-4">
                    <a asp-page="/Auth/Login" class="btn btn-action px-4 py-2" style="font-size: 14px; font-weight: 600;">
                        <svg class="icon-duotone icon-sm me-1" viewBox="0 0 24 24"><circle class="bg-shape" cx="12" cy="7" r="4"/><path class="stroke-shape" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/></svg>
                        Đăng Nhập Bằng Email Trường →
                    </a>
                    <a asp-page="/Auth/Register" class="btn btn-secondary px-4 py-2" style="font-size: 14px; font-weight: 600;">
                        Đăng Ký Tài Khoản Mới
                    </a>
                </div>

                <!-- Dải Giá & Cam Kết Nằm Ngang Tối Giản -->
                <div class="d-flex justify-content-center align-items-center gap-3 flex-wrap text-muted small pt-3 border-top" style="border-color: var(--border-subtle) !important; font-size: 12.5px;">
                    <div>Đen trắng A4: <strong class="text-dark">350 đ/trang</strong></div>
                    <span>·</span>
                    <div>Màu laser A4: <strong class="text-dark">1.500 đ/trang</strong></div>
                    <span>·</span>
                    <div style="color: var(--intent-confirm-base); font-weight: 600;">In 2 mặt giảm 10%</div>
                    <span>·</span>
                    <div>Giờ mở quầy: <strong class="text-dark">07:30 – 17:30</strong></div>
                </div>
            </div>

            <!-- Quy Trình 3 Bước Dạng Ngang Tối Giản (Hoàn toàn không đóng khung lặp lại) -->
            <div class="row g-3 text-center">
                <div class="col-md-4">
                    <div class="p-3 rounded-2 h-100" style="background-color: var(--surface-card); border: 1px solid var(--border-card);">
                        <span class="mono fw-bold d-block mb-1" style="font-size: 12px; color: var(--intent-action-base);">BƯỚC 01</span>
                        <strong style="font-size: 13.5px; color: var(--text-heading); display: block;" class="mb-1">Tải Tệp Lên</strong>
                        <p class="text-muted small mb-0" style="font-size: 12px; line-height: 1.45;">
                            Nạp tệp PDF hoặc Word từ điện thoại hoặc máy tính.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-2 h-100" style="background-color: var(--surface-card); border: 1px solid var(--border-card);">
                        <span class="mono fw-bold d-block mb-1" style="font-size: 12px; color: var(--intent-action-base);">BƯỚC 02</span>
                        <strong style="font-size: 13.5px; color: var(--text-heading); display: block;" class="mb-1">Chốt Giá Cố Định</strong>
                        <p class="text-muted small mb-0" style="font-size: 12px; line-height: 1.45;">
                            Tùy chọn in màu, đen trắng, 2 mặt và xem chi phí tự động.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
